{
  "name": "langhub-cli",
  "version": "0.2.0",
  "description": "Move translations between LangHub and a repository. Carries the strings, guarantees the keys, and leaves what a value means to the i18n library reading it.",
  "keywords": [
    "langhub",
    "i18n",
    "l10n",
    "localization",
    "translations",
    "cli"
  ],
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenle0608/LangHub.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/nguyenle0608/LangHub#readme",
  "bugs": "https://github.com/nguyenle0608/LangHub/issues",
  "bin": {
    "langhub": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run --root .. cli/src",
    "prepublishOnly": "npm run build"
  }
}
